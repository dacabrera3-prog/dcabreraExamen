<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dcabreraExamen.Resumen">

    <VerticalStackLayout Padding="20" Spacing="10">

        
        <Label x:Name="lblUsuario" HorizontalOptions="End" FontAttributes="Bold"/>

       
        <Label Text="RESUMEN" FontSize="18" HorizontalOptions="Center" Margin="0,0,0,20"/>

        
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*, *" RowSpacing="15">
            <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" FontAttributes="Bold"/>
            <Label Grid.Row="0" Grid.Column="1" x:Name="lblNombre"/>

            <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" FontAttributes="Bold"/>
            <Label Grid.Row="1" Grid.Column="1" x:Name="lblApellido"/>

            <Label Grid.Row="2" Grid.Column="0" Text="Edad:" FontAttributes="Bold"/>
            <Label Grid.Row="2" Grid.Column="1" x:Name="lblEdad"/>

            <Label Grid.Row="3" Grid.Column="0" Text="Fecha:" FontAttributes="Bold"/>
            <Label Grid.Row="3" Grid.Column="1" x:Name="lblFecha"/>

            <Label Grid.Row="4" Grid.Column="0" Text="Ciudad:" FontAttributes="Bold"/>
            <Label Grid.Row="4" Grid.Column="1" x:Name="lblCiudad"/>

            <Label Grid.Row="5" Grid.Column="0" Text="País:" FontAttributes="Bold"/>
            <Label Grid.Row="5" Grid.Column="1" x:Name="lblPais"/>

            <Label Grid.Row="6" Grid.Column="0" Text="Monto Inicial:" FontAttributes="Bold"/>
            <Label Grid.Row="6" Grid.Column="1" x:Name="lblMontoInicial"/>

            <Label Grid.Row="7" Grid.Column="0" Text="Pago mensual:" FontAttributes="Bold"/>
            <Label Grid.Row="7" Grid.Column="1" x:Name="lblPagoMensual"/>

            <Label Grid.Row="8" Grid.Column="0" Text="Pago Total:" FontAttributes="Bold" TextColor="Green"/>
            <Label Grid.Row="8" Grid.Column="1" x:Name="lblPagoTotal" TextColor="Green" FontAttributes="Bold"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>