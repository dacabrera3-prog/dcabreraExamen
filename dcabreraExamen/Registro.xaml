<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dcabreraExamen.Registro">

    <VerticalStackLayout Padding="20" Spacing="15">

       
        <Label x:Name="lblUsuario" HorizontalOptions="End" FontAttributes="Bold"/>

      
        <Label Text="REGISTRO" FontSize="18" HorizontalOptions="Center" />

        
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*, 1.5*" RowSpacing="10" Margin="0,10,0,10">
            <Label Grid.Row="0" Grid.Column="0" Text="FECHA" VerticalOptions="Center"/>
            <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpFecha"/>

            <Label Grid.Row="1" Grid.Column="0" Text="PAÍS" VerticalOptions="Center"/>
            <Picker Grid.Row="1" Grid.Column="1" x:Name="pkPais" Title="PAISES">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Ecuador</x:String>
                        <x:String>Colombia</x:String>
                        <x:String>Perú</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Grid.Row="2" Grid.Column="0" Text="CIUDAD" VerticalOptions="Center"/>
            <Picker Grid.Row="2" Grid.Column="1" x:Name="pkCiudad" Title="CIUDADES">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Cuenca</x:String>
                        <x:String>Quito</x:String>
                        <x:String>Guayaquil</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Grid.Row="3" Grid.Column="0" Text="Monto Inicial" VerticalOptions="Center"/>
            <Entry Grid.Row="3" Grid.Column="1" x:Name="txtMonto" Placeholder="INGRESE EL MONTO INICIAL" Keyboard="Numeric"/>

            <Button Grid.Row="4" Grid.Column="0" Text="Calcular Pago mensual" Clicked="OnCalcularClicked" FontSize="12" Margin="0,0,5,0"/>
            
            <Entry Grid.Row="4" Grid.Column="1" x:Name="txtPagoMensual" IsReadOnly="True" BackgroundColor="#E0E0E0"/>
        </Grid>

       
        <BoxView HeightRequest="1" Color="Gray" Margin="0,10,0,10"/>

        
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="5">
            <Label Grid.Row="0" Grid.Column="0" Text="NOMBRE"/>
            <Label Grid.Row="0" Grid.Column="1" Text="APELLIDO"/>
            <Label Grid.Row="0" Grid.Column="2" Text="EDAD"/>

            <Entry Grid.Row="1" Grid.Column="0" x:Name="txtNombre" Placeholder="Ingresar Nombre"/>
            <Entry Grid.Row="1" Grid.Column="1" x:Name="txtApellido" Placeholder="Ingresar Apellido"/>
            <Entry Grid.Row="1" Grid.Column="2" x:Name="txtEdad" Placeholder="Ingresar Edad" Keyboard="Numeric"/>
        </Grid>

        
        <Button Text="Ver resumen" Clicked="OnResumenClicked"/>

    </VerticalStackLayout>
</ContentPage>